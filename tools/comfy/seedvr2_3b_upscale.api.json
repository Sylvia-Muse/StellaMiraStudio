{
  "_meta": {
    "name": "放大：SeedVR2 3B int8 视频放大（→1080p，时间一致，不抖）",
    "source": "本机 ComfyUI 0.38 原生节点；接线照官方 blueprint blueprints/upscale_video_seedvr2_3b_int8.json（UNETLoader → SeedVR2Conditioning → KSampler(steps=1) → VAEDecodeTiled → SeedVR2PostProcessing）",
    "models": [
      "diffusion_models/seedvr2_3b_int8_convrot.safetensors (3.46 GB)",
      "vae/seedvr2_ema_vae_fp16.safetensors（SeedVR2 专用 VAE，不能用 wan vae）"
    ],
    "vram": "权重 3.46GB + 分块解码；按 512 tile / 64 帧块跑 1080p，估算峰值 6~9GB（官方定位低显存档，3B 是低显存版）",
    "license": "SeedVR2 (ByteDance-Seed) = Apache-2.0，可商用",
    "note": "改动点：用 ImageScale 固定到目标分辨率（1920x1080），而不是 blueprint 里的 multiplier 动态节点",
    "how_to_run": "python3 scripts/comfy/run_workflow.py scripts/comfy/seedvr2_3b_upscale.api.json --set 3:file='wan22_out.mp4'"
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "seedvr2_3b_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "seedvr2_ema_vae_fp16.safetensors"
    }
  },
  "3": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "wan22_out.mp4"
    }
  },
  "4": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["3", 0]
    }
  },
  "5": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "lanczos",
      "width": 1920,
      "height": 1080,
      "crop": "disabled"
    }
  },
  "6": {
    "class_type": "SeedVR2Preprocess",
    "inputs": {
      "resized_images": ["5", 0]
    }
  },
  "7": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": ["6", 0],
      "vae": ["2", 0],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "8": {
    "class_type": "SeedVR2Conditioning",
    "inputs": {
      "model": ["1", 0],
      "vae_conditioning": ["7", 0]
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": 20260306,
      "steps": 1,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["2", 0],
      "tile_size": 512,
      "overlap": 128,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "11": {
    "class_type": "SeedVR2PostProcessing",
    "inputs": {
      "images": ["10", 0],
      "original_resized_images": ["5", 0],
      "color_correction_method": "none"
    }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": 24.0
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "mv/upscaled_1080p",
      "format": "auto",
      "codec": "auto"
    }
  }
}
