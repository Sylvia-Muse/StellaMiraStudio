{
  "_meta": {
    "name": "Wan2.2 TI2V-5B 文生视频（一句歌词 → 3~5 秒画面）",
    "source": "参数取自 Comfy-Org 官方模板 templates/video_wan2_2_5B_ti2v.json（KSampler 20 步 / cfg 5 / uni_pc / simple / ModelSamplingSD3 shift 8 / 24fps）",
    "models": [
      "diffusion_models/wan2.2_ti2v_5B_fp16.safetensors (10.00 GB)",
      "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors (6.74 GB)",
      "vae/wan2.2_vae.safetensors (1.41 GB)"
    ],
    "vram": "官方口径：ComfyUI 原生 offload 下 8GB 可用；本机实测空载峰值待测（建议先 832x480x97）",
    "license": "Wan2.2 全系 Apache-2.0，可商用",
    "length_rule": "length 必须 = 4n+1；97 帧 @24fps ≈ 4.04s，121 帧 ≈ 5.04s",
    "how_to_run": "python3 scripts/comfy/run_workflow.py scripts/comfy/wan22_5b_t2v.api.json --base http://127.0.0.1:8188 --set 5:text='你的歌词画面描述'"
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["1", 0],
      "shift": 8.0
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "水墨风格的少女背影立在飘落的彼岸花瓣中，长发与衣摆被风吹动，镜头缓慢推近，画面有细微的墨色扩散，环境光柔和，电影感构图",
      "clip": ["3", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": ["3", 0]
    }
  },
  "7": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["4", 0],
      "width": 832,
      "height": 480,
      "length": 97,
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": 20260306,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["4", 0]
    }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["9", 0],
      "fps": 24.0
    }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["10", 0],
      "filename_prefix": "mv/wan22_5b_t2v",
      "format": "auto",
      "codec": "auto"
    }
  }
}
