{
  "_meta": {
    "name": "首尾帧插值（Wan2.1 FLF2V-720P 14B fp8）",
    "source": "节点 WanFirstLastFrameToVideo 为本机 ComfyUI 0.38 原生节点（node_id 已核实存在）",
    "models": [
      "diffusion_models/wan2.1_flf2v_720p_14B_fp8_e4m3fn.safetensors (16.40 GB)",
      "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors (6.74 GB)",
      "vae/wan_2.1_vae.safetensors (0.25 GB)"
    ],
    "vram": "权重 16.4GB + 激活；参考同类 14B fp8 实测峰值 21~24GB（RTX 3090 24GB，aidev.edu.vn 2026-10-17）。⇒ 必须等机器空出来（≥20GB 空闲），别人占 20GB 时跑不了",
    "license": "Wan2.1 Apache-2.0，可商用",
    "length_rule": "length = 4n+1；81 帧 @16fps ≈ 5.06s。FLF2V 训练分布为 720p/16fps，别硬拉 24fps",
    "how_to_run": "python3 scripts/comfy/run_workflow.py scripts/comfy/wan2_1_flf2v_720p.api.json --set 7:image='a.png' --set 8:image='b.png'"
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_flf2v_720p_14B_fp8_e4m3fn.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["1", 0],
      "shift": 8.0
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "frame_a.png"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "frame_b.png"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "镜头平稳推移，衣摆与发丝自然飘动，水波缓慢扩散，光影连续变化，人物保持一致",
      "clip": ["3", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": ["3", 0]
    }
  },
  "9": {
    "class_type": "WanFirstLastFrameToVideo",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "vae": ["4", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1,
      "start_image": ["7", 0],
      "end_image": ["8", 0]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": 20260306,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["4", 0]
    }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": 16.0
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "mv/flf2v_wan21",
      "format": "auto",
      "codec": "auto"
    }
  }
}
